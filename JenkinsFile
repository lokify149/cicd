pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                bat 'gcc main.c -o app.exe'
            }
        }

        stage('Test') {
            steps {
                bat 'gcc test.c -o test.exe'
                bat 'test.exe'
            }
        }

        stage('Package Artifact') {
            steps {
                bat 'mkdir artifact'
                bat 'copy app.exe artifact\\'
            }
        }

        stage('Deploy') {
    steps {
        bat 'copy app.exe C:\\Users\\Happy\\OneDrive\\Desktop\\deployment-server\\app\\'
        bat 'C:\\Users\\Happy\\OneDrive\\Desktop\\deployment-server\\app\\app.exe'
    }
}

    }
}