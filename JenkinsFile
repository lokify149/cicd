pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                bat 'gcc main.c -o app.exe'
            }
        }

        stage('Test') {
            steps {
                bat 'gcc test.c -o test.exe'
                bat 'test.exe'
            }
        }

        stage('Deploy') {
            steps {
                 bat '''
                if not exist deploy mkdir deploy
                copy app.exe deploy\
                deploy\app.exe
                '''
            }
        }

    }
}